{
  "manifest_version": 3,
  "name": "Mnema — память для ИИ",
  "version": "0.1.0",
  "description": "Подставляет твою память в ChatGPT и Gemini и сохраняет важное из разговоров. Память живёт у тебя на компьютере.",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://gemini.google.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": { "default_title": "Mnema", "default_popup": "options.html" }
}
